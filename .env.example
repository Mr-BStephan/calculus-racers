# Firebase public web-app configuration. Never place service account keys here.
VITE_FIREBASE_CONFIG={"apiKey":"PUBLIC_WEB_API_KEY","authDomain":"YOUR_PROJECT.firebaseapp.com","databaseURL":"https://YOUR_DATABASE.firebasedatabase.app","projectId":"YOUR_PROJECT","appId":"YOUR_WEB_APP_ID"}
# For local emulator testing, omit config above and set this instead:
# VITE_USE_EMULATORS=true
